# Shubba — environment variable template
#
# Copy to `.env` next to index.js and fill in real values:
#     cp .env.example .env
# `.env` is gitignored; this template is not. NEVER put real secrets in here.
#
# On SparkedHost you can instead set these in the panel:
#     Panel -> your server -> Startup tab -> Variables
# index.js loads `.env` with `override: true`, so when both exist the .env file
# wins over panel/process variables. See docs/DEPLOY.md.
#
# Every variable below is read by index.js. Nothing is hardcoded in the source.


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the bot exits on startup if either of these is missing
# ─────────────────────────────────────────────────────────────────────────────

# Discord bot token. Developer Portal -> your app -> Bot -> Reset Token.
DISCORD_TOKEN=

# Google Gemini API key. https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# ADMIN DASHBOARD — required to enable the web panel (fails CLOSED if unset)
# ─────────────────────────────────────────────────────────────────────────────
# The dashboard is served on a PUBLIC IP (see PUBLIC_BASE_URL below), so there
# is deliberately no default and no fallback password. If either of these is
# unset, /dashboard, /admin and every /api/ route return 401 to everyone —
# the bot still runs, but the panel is locked.
#
# Use a long random password; it protects bot restart/config endpoints.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

DASHBOARD_USER=
DASHBOARD_PASS=


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL INTEGRATIONS — unset just disables that feature, the bot still boots
# ─────────────────────────────────────────────────────────────────────────────

# CurseForge API key, used only by the mod download-analytics tracker.
# Unset => CurseForge numbers are skipped and reported as 0; Modrinth tracking
# is unaffected and the bot logs a warning at startup.
# Get one at https://console.curseforge.com/ -> API Keys.
CF_API_KEY=

# Trello board sync. Both must be set or the sync is skipped.
# https://trello.com/power-ups/admin
TRELLO_KEY=
TRELLO_TOKEN=

# Groq — alternative AI provider, OFF by default.
# Groq's free tier caps at 12,000 tokens/min, which is too small for Shubba's
# prompts (~30-40k tokens with the knowledge base), so this needs their paid
# Dev tier to be usable. Set USE_GROQ=true to route through Groq instead of
# Gemini. Key: https://console.groq.com/keys
USE_GROQ=false
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile


# ─────────────────────────────────────────────────────────────────────────────
# GEMINI MODEL ROUTING — all optional, sensible defaults in index.js
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated model chains, tried left to right. Each model has its own
# daily free-tier quota, so when one 429s for the day Shubba rotates to the
# next instead of going down. A model not enabled on your key (404) is dropped
# for the process. Change these to upgrade models without a redeploy.

# GEMINI_CHAIN_STANDARD=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-flash-lite
# GEMINI_CHAIN_WIKI=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-flash-lite

# Legacy single-model overrides. Still honoured — whatever you set here is
# pinned to the FRONT of the corresponding chain above.
# GEMINI_MODEL_STANDARD=
# GEMINI_MODEL_WIKI=


# ─────────────────────────────────────────────────────────────────────────────
# HOSTING / PATHS — all optional
# ─────────────────────────────────────────────────────────────────────────────

# Discord application (client) ID, used to register slash commands.
# Not a secret. Defaults to the Punchy! app ID if unset.
# CLIENT_ID=1465165237358559386

# Port for the dashboard + public file server. SparkedHost sets PORT for you.
# SERVER_PORT is a fallback name; defaults to 8080 for local dev.
# PORT=8080
# SERVER_PORT=8080

# Public base URL used to build teaser/file links posted into Discord.
# Must be reachable from the internet or those links break.
# PUBLIC_BASE_URL=http://212.192.28.228:25547

# Where bot data (FAQ, tickets, rules, teasers, snapshots) is written on disk.
# SHUBBA_STORAGE_DIR=/home/container/shubba-files
